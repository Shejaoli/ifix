# Create a fresh PostgreSQL database and use its connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ifix
# Generate a unique random value for every deployment.
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# On an empty database only, these create the first admin. Use a unique password (12+ characters).
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-strong-password
